// Scriptorium — the rendering layer.
//
// Wraps Scribe (the vendored Twig-style engine) and centralises where template
// files live. Handlers build a small context map and call render_public /
// render_admin; this file injects the shared "site" context (title, nav, the
// current user) so every template can rely on it.
//
// Dependency graph:  render -> auth -> db -> util   and   render -> lib/scribe
//
// Scribe is a git submodule (upstream: WebFirstLanguage/Scribe), so this path
// only resolves once the submodule is checked out:
//     git submodule update --init --recursive
include from "auth.wfl"
include from "../lib/scribe/src/scribe.wfl"

// Shared site context, present on every page as `site`.
define action called site_context with parameters conn and user:
    store nav_pages as page_list_published of conn
    store yr_rows as query conn with "SELECT strftime('%Y','now') AS y"
    store yr_row as yr_rows[0]
    create map site_map:
        "title" is setting_get of conn and "site_title" and "Scriptorium"
        "tagline" is setting_get of conn and "site_tagline" and "Words, well kept."
        "nav" is nav_pages
        "user" is user
        "is_admin" is is_admin of user
        "csrf" is field_or of user and "csrf_token" and ""
        "asset_base" is "/assets"
        "year" is yr_row["y"]
    end map
    return site_map
end action

// Where public body templates are looked up. Defaults to the base theme's
// legacy layout so an unconfigured install behaves exactly as before; boot
// overrides it from `.wflcfg` (`theme` / `theme_root`) via the setter below.
// A mutable module-level store is the only way to share this: main.wfl cannot
// assign to a variable defined in an included file, but it can call an action
// that does.
store public_template_root as "themes/base/templates/"
store public_template_alt as "themes/base/templates/"

// Point public rendering at a theme. `root_dir` is the directory holding
// themes (e.g. "themes", or an out-of-tree path); `theme_name` selects one.
// Both region-aware (`<theme>/body/`) and legacy (`<theme>/templates/`) shapes
// resolve, so a theme may use either without an engine change.
define action called set_public_theme with parameters root_dir and theme_name:
    change public_template_root to root_dir with "/" with theme_name with "/body/"
    change public_template_alt to root_dir with "/" with theme_name with "/templates/"
    return public_template_root
end action

// Render a public theme template (path relative to the repo root / CWD).
// Resolution order: the configured theme's `body/`, then its `templates/`,
// then the base theme — so a theme may override only the pages it cares about.
define action called render_public with parameters template_name and ctx:
    store primary_path as public_template_root with template_name
    check if file exists at primary_path:
        return scribe_render_file of primary_path and ctx
    end check
    store alt_path as public_template_alt with template_name
    check if file exists at alt_path:
        return scribe_render_file of alt_path and ctx
    end check
    return scribe_render_file of ("themes/base/templates/" with template_name) and ctx
end action

// Render an admin-panel template.
define action called render_admin with parameters template_name and ctx:
    return scribe_render_file of ("admin/templates/" with template_name) and ctx
end action
