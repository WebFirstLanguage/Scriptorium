// Capability gates, intentionally failing until the runtime supports the
// required contracts. These do not replace the existing regression suites.
// Run from any directory with the selected WFL runtime on PATH:
//   wfl --test tests/runtime/process-capabilities.test.wfl

describe "WFL process contracts required by the complete suite":
    test "direct children can use an isolated fixture working directory":
        store fixture_directory as path_join of script_directory and "fixtures"
        store fixture_path as path_join of fixture_directory and "process-child.wfl"
        wait for execute command "wfl" with arguments [fixture_path] as child_result
        expect child_result["exit_code"] to equal 0
        // There is currently no native per-launch working-directory clause.
        // An absolute source path still executes relative file I/O in the
        // parent's directory. This fails the isolation requirement directly.
        expect child_result["output"] to contain fixture_directory
    end test

    test "final captured output remains readable after waiting for exit":
        store fixture_directory as path_join of script_directory and "fixtures"
        store fixture_path as path_join of fixture_directory and "process-child.wfl"
        wait for spawn command "wfl" with arguments [fixture_path] as child_process
        store final_output as ""
        try:
            wait for process child_process to complete as child_exit
            expect child_exit to equal 0
            try:
                wait for read output from process child_process as captured_output
                change final_output to captured_output
            when error:
                display "Runtime discarded the completed process handle: " with error_message
            end try
        finally:
            check if process child_process is running:
                kill process child_process
            end check
        end try
        expect final_output to contain "synthetic child output"
    end test

    test "background process diagnostics preserve stderr":
        store fixture_directory as path_join of script_directory and "fixtures"
        store fixture_path as path_join of fixture_directory and "process-error.wfl"
        wait for execute command "wfl" with arguments [fixture_path] as foreground_result
        expect foreground_result["error"] to contain "Division by zero"
        wait for spawn command "wfl" with arguments [fixture_path] as child_process
        store child_diagnostics as ""
        try:
            count from 1 to 100:
                check if (process child_process is running) is no:
                    break
                end check
                wait for 100 milliseconds
            end count
            expect (process child_process is running) to equal no
            wait for read output from process child_process as captured_output
            change child_diagnostics to captured_output
            wait for process child_process to complete as child_exit
            expect child_exit to equal 1
        finally:
            check if process child_process is running:
                kill process child_process
            end check
        end try
        expect child_diagnostics to contain "Division by zero"
    end test

    test "finally terminates a directly owned child after a controlled error":
        store fixture_directory as path_join of script_directory and "fixtures"
        store fixture_path as path_join of fixture_directory and "process-blocking.wfl"
        wait for spawn command "wfl" with arguments [fixture_path] as child_process
        store observed_error as no
        try:
            wait for 300 milliseconds
            expect (process child_process is running) to equal yes
            store invalid_result as 1 divided by 0
            display invalid_result
        when error:
            change observed_error to yes
        finally:
            check if process child_process is running:
                kill process child_process
            end check
        end try
        expect observed_error to equal yes
        expect (process child_process is running) to equal no
    end test
end describe
